# ==============================================================================
# docker-torrent Environment Configuration Template
# ==============================================================================

# Timezone and Identity
TZ=America/Detroit
PUID=999
PGID=110
UMASK=002

# Paths
DATA_DIR=/opt/homelab/prod/data/docker-torrent
MEDIA_DIR=/mnt/nas/media

# Network & Ports
GLUETUN_HTTP_PROXY_PORT=8888
TRANSMISSION_WEB_PORT=9091
VPN_FORWARDED_PORT=8999

# VPN Credentials (Mullvad WireGuard)
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_ADDRESSES=10.66.252.138/32

# Transmission Web UI Authentication
TRANSMISSION_USER=gemini
TRANSMISSION_PASS=change_me
